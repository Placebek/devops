# Golang 1.20 образын қолданамыз
FROM golang:1.20

# Контейнер ішіндегі жұмыс каталогы
WORKDIR /app

# Барлық файлдарды контейнерге көшіру
COPY . .

# Go модулін инициализациялау (егер жоқ болса)
RUN go mod init myapp || true
RUN go mod tidy

# Go binary құрастыру
RUN go build -o main .

# Контейнер іске қосылғанда орындалатын команда
CMD ["./main"]
